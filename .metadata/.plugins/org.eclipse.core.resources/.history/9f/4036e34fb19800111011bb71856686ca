package com.food_registry.order.mapper;

import org.springframework.stereotype.Component;

import com.food_registry.order.dto.OrderDTO;
import com.food_registry.order.entity.Order;

@Component
public class OrderMapper {
//	Entity to DTO
	public OrderDTO toDto(Order order) {
		if(order == null) return null;
		
		OrderDTO dto = new OrderDTO();
		dto.setOrderId(order.getOrderId());
		dto.setFoodItemsList(order.getFoodItemsList());
		dto.setRestaurant(order.getRestaurant());
		dto.setUserDTO(order.getUserDTO());
		
		return dto;
	}
	
//	DTO to Entity
	public Order toEntity(OrderDTO dto) {
		if(dto == null) return null;
		
		Order order = new Order();
		order.setOrderId(dto.getOrderId());
		order.setFoodItemsList(dto.getFoodItemsList());
		order.setRestaurant(dto.getRestaurant());
		order.setUserDTO(dto.getUserDTO());
		
		return order;
	}
}
